# 默认 mock 模式无需 API Key。接入真实模型时复制为 .env 后自行填写。
LLM_PROVIDER=mock

# 豆包(火山引擎 ARK)API 配置
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包模型 Endpoint ID / 模型名(在火山引擎控制台创建推理接入点后获得)
ARK_CHAT_MODEL=
ARK_EMBED_MODEL=

DB_PATH=data_odm_demo.db
PLAYBOOK_SCORE_THRESHOLD=0.3
RESET_DEMO_RUNTIME_ON_START=true
